import "./IEngine/IEngine";
import "./IEngine/rule_presets";
import "std/io";

fn main() -> int32 {

   add_parent("alice", "bob");
   add_parent("bob", "carol");
   add_parent("carol", "dave");
   add_parent("alice", "eve");
   add_parent("eve", "frank");

   add_female("alice");
   add_female("eve");
   add_female("carol");
   add_female("grace");

   add_male("bob");
   add_male("dave");
   add_male("frank");
   add_male("henry");

   add_spouse("bob", "grace");
   add_spouse("carol", "henry");

   add_family_rules();

   set_trace_inference(0);
   run_forward_chaining();


   // raw dump of working memory
   // display_working_memory();

   // grouped relationships by type
   // display_relationships();

   // human‑readable
   println("--- Readable Relationships ---");
   var i: int32 = 0;
   while (i < return_wm_count) {
       print("  ");
       print_fact_readable(return_wm_at(i));
       i += 1;
   }

   // focus on a single person
   // display_relationships_for("alice");
   display_relationships_for("bob");

   // family tree
   // println("");
   // println("Family Tree (descendants of alice):");
   // print_descendants("alice", 0);

   // query examples "" as wildcard
   // query("grandparent", "alice", "");
   // query("grandchild", "", "alice");
   query("cousin", "carol", "");

   // will display the counts of each relation ship
   // display_counts();

   println("");
   println("Complete Family Trees:");
   print_all_family_trees();

   return 0;
}
