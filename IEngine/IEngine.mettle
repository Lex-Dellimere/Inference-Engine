   print_count("brother_in_law", "Brothers-in-law");
   print_count("stepchild", "Stepchildren");
   print_count("stepdaughter", "Stepdaughters");
   print_count("stepson", "Stepsons");
   print_count("stepmother", "Stepmothers");
   print_count("stepfather", "Stepfathers");
}

export fn add_fact(f: Fact*) -> int32 {
   if (fact_exists(f)) {
      return 0;
   }

   if (wm_count >= 100) {
      // handle more gracefully
      return 0;
   }
   wm[wm_count].predicate = f->predicate;
   wm[wm_count].arity = f->arity;
   var i: int32 = 0;
   while (i < f->arity) {
       wm[wm_count].args[i] = f->args[i];
       i += 1;
   }
   wm_count += 1;
   return 1;
}

export fn add_parent(mother: string, father: string) -> int32 {
   var fact: Fact;
   fact.predicate = "parent";
   fact.arity = 2;
   fact.args[0] = mother;
   fact.args[1] = father;
   add_fact(&fact);
   return 0;
}

export fn add_male(name: string) -> void {
   var f: Fact;
   f.predicate = "male";
   f.arity = 1;
   f.args[0] = name;
   add_fact(&f);
}

export fn add_female(name: string) -> void {
   var f: Fact;
   f.predicate = "female";
   f.arity = 1;
   f.args[0] = name;
   add_fact(&f);
}

export fn add_spouse(a: string, b: string) -> void {
   var f: Fact;
   f.predicate = "spouse";
   f.arity = 2;
   f.args[0] = a;
   f.args[1] = b;
   add_fact(&f);
}
