fn print_children(parent: string, prefix: string) -> void {
   var child_count: int32 = 0;
   var i: int32 = 0;

   while (i < wm_count) {
      if (wm[i].predicate == "parent" &&
          wm[i].arity == 2 &&
          wm[i].args[0] == parent) {
         child_count += 1;
      }
      i += 1;
   }

   var idx: int32 = 0;
   i = 0;
   while (i < wm_count) {
      if (wm[i].predicate == "parent" &&
          wm[i].arity == 2 &&
          wm[i].args[0] == parent) {

         var child: string = wm[i].args[1];
         var is_last: int32 = 0;
         if (idx == child_count - 1) {
            is_last = 1;
         }

         print(prefix);
         if (is_last == 1) {
            print("└── ");
         } else {
            print("├── ");
         }
         println(child);

         var new_prefix: string = prefix;
         if (is_last == 1) {
            new_prefix = new_prefix + "    ";
         } else {
            new_prefix = new_prefix + "│   ";
         }

         print_children(child, new_prefix);

         idx += 1;
      }
      i += 1;
   }
}

export fn print_descendants(root: string, depth: int32) -> void {
   println(root);
   var prefix: string = "";
   print_children(root, prefix);
}

export fn query(predicate: string, arg1: string, arg2: string) -> void {
   println("");
   print("Query: ");
   print(predicate);
   print("(");
   print(arg1);
   print(", ");
   print(arg2);
   println(")");

   var i: int32 = 0;
   var found: int32 = 0;
   while (i < wm_count) {
      if (wm[i].predicate == predicate && wm[i].arity == 2) {
         var a_match: int32 = 1;
         if (arg1 != "" && wm[i].args[0] != arg1) {
            a_match = 0;
         }
         if (arg2 != "" && wm[i].args[1] != arg2) {
            a_match = 0;
         }
         if (a_match) {
            print("  ");
            print_fact_readable(&wm[i]);
            println("");
            found = 1;
         }
      }
      i += 1;
   }

   if (!found) {
      println("  No results.");
   }
}

export fn display_relationships_for(name: string) -> void {
   println("");
   print("Relationships involving ");
   println(name);
   println(":");

   var i: int32 = 0;
   var found: int32 = 0;
   while (i < wm_count) {
      var f: Fact = wm[i];
      var j: int32 = 0;
      var has_name: int32 = 0;
      while (j < f.arity) {
         if (f.args[j] == name) {
            has_name = 1;
            break;
         }
         j += 1;
      }
      if (has_name) {
         print("  ");
         print_fact_readable(&f);
         println("");
         found = 1;
      }
      i += 1;
   }

   if (!found) {
      println("  (none)");
   }
}

export fn print_all_family_trees() -> void {
   var roots: string[100];
   var root_count: int32 = 0;

   // Find all people who are parents but have no known parents themselves.
   var i: int32 = 0;
   while (i < wm_count) {
      if (wm[i].predicate == "parent" && wm[i].arity == 2) {
         var candidate: string = wm[i].args[0];

         if (!has_parent(candidate)) {
            // Check if candidate is already in roots.
            var already: int32 = 0;
            var j: int32 = 0;
            while (j < root_count) {
               if (roots[j] == candidate) {
                  already = 1;
                  break;
               }
               j += 1;
            }

            if (!already && root_count < 100) {
               roots[root_count] = candidate;
               root_count += 1;
            }
         }
      }
      i += 1;
   }

   // Print a tree for each root.
   var r: int32 = 0;
   while (r < root_count) {
      println("");
      print("Family tree for ");
      println(roots[r]);
      print_descendants(roots[r], 0);
      r += 1;
   }
}

export fn print_fact_readable(f: Fact*) -> void {
   if (f->arity == 1) {
      if (f->predicate == "male") {
         print(f->args[0]);
         println(" is male");
      } else if (f->predicate == "female") {
         print(f->args[0]);
         println(" is female");
      } else {
         print_fact(f);
         println("");
      }
      return;
   }

   if (f->arity != 2) {
      print_fact(f);
      println("");
      return;
   }

   var a: string = f->args[0];
   var b: string = f->args[1];

   if (f->predicate == "parent") {
      print(a); print(" is a parent of "); println(b);
   } else if (f->predicate == "child") {
      print(a); print(" is a child of "); println(b);
   } else if (f->predicate == "mother") {
      print(a); print(" is the mother of "); println(b);
   } else if (f->predicate == "father") {
      print(a); print(" is the father of "); println(b);
   } else if (f->predicate == "son") {
      print(a); print(" is a son of "); println(b);
   } else if (f->predicate == "daughter") {
      print(a); print(" is a daughter of "); println(b);
   } else if (f->predicate == "sibling") {
      print(a); print(" is a sibling of "); println(b);
   } else if (f->predicate == "brother") {
      print(a); print(" is a brother of "); println(b);
   } else if (f->predicate == "sister") {
      print(a); print(" is a sister of "); println(b);
   } else if (f->predicate == "spouse") {
      print(a); print(" is a spouse of "); println(b);
   } else if (f->predicate == "wife") {
      print(a); print(" is the wife of "); println(b);
   } else if (f->predicate == "husband") {
      print(a); print(" is the husband of "); println(b);
   } else if (f->predicate == "grandparent") {
      print(a); print(" is a grandparent of "); println(b);
   } else if (f->predicate == "grandchild") {
      print(a); print(" is a grandchild of "); println(b);
   } else if (f->predicate == "grandmother") {
      print(a); print(" is the grandmother of "); println(b);
   } else if (f->predicate == "grandfather") {
      print(a); print(" is the grandfather of "); println(b);
   } else if (f->predicate == "granddaughter") {
      print(a); print(" is a granddaughter of "); println(b);
   } else if (f->predicate == "grandson") {
      print(a); print(" is a grandson of "); println(b);
   } else if (f->predicate == "aunt") {
      print(a); print(" is an aunt of "); println(b);
   } else if (f->predicate == "uncle") {
      print(a); print(" is an uncle of "); println(b);
   } else if (f->predicate == "niece") {
      print(a); print(" is a niece of "); println(b);
   } else if (f->predicate == "nephew") {
      print(a); print(" is a nephew of "); println(b);
   } else if (f->predicate == "cousin") {
      print(a); print(" is a cousin of "); println(b);
   } else if (f->predicate == "ancestor") {
      print(a); print(" is an ancestor of "); println(b);
   } else if (f->predicate == "descendant") {
      print(a); print(" is a descendant of "); println(b);
   } else if (f->predicate == "parent_in_law") {
      print(a); print(" is a parent‑in‑law of "); println(b);
   } else if (f->predicate == "mother_in_law") {
      print(a); print(" is the mother‑in‑law of "); println(b);
   } else if (f->predicate == "father_in_law") {
      print(a); print(" is the father‑in‑law of "); println(b);
   } else if (f->predicate == "child_in_law") {
      print(a); print(" is a child‑in‑law of "); println(b);
   } else if (f->predicate == "daughter_in_law") {
      print(a); print(" is a daughter‑in‑law of "); println(b);
   } else if (f->predicate == "son_in_law") {
      print(a); print(" is a son‑in‑law of "); println(b);
   } else if (f->predicate == "sibling_in_law") {
      print(a); print(" is a sibling‑in‑law of "); println(b);
   } else if (f->predicate == "sister_in_law") {
      print(a); print(" is a sister‑in‑law of "); println(b);
   } else if (f->predicate == "brother_in_law") {
      print(a); print(" is a brother‑in‑law of "); println(b);
   } else if (f->predicate == "stepchild") {
      print(a); print(" is a stepchild of "); println(b);
   } else if (f->predicate == "stepdaughter") {
      print(a); print(" is a stepdaughter of "); println(b);
   } else if (f->predicate == "stepson") {
      print(a); print(" is a stepson of "); println(b);
   } else if (f->predicate == "stepmother") {
      print(a); print(" is the stepmother of "); println(b);
   } else if (f->predicate == "stepfather") {
      print(a); print(" is the stepfather of "); println(b);
   } else {
      print_fact(f);
      println("");
   }
}

