// INTERNAL

// term inside a pattern is either an atom or a variable
struct Term {
    kind: int32;
    name: string;
}

// a pattern for a fact
struct AtomPattern {
    predicate: string;
    args: Term[4];
    arity: int32;
}

// A fact, all args are atoms
struct Fact {
    predicate: string;
    args: string[4];
    arity: int32;
}

// a binding maps var names to values
struct Binding {
    vars: string[4];
    values: string[4];
    count: int32;
}

// A rule, list of condition patterns and one action pattern.
export struct Rule {
    conditions: AtomPattern[4];
    action: AtomPattern;
    cond_count: int32;
}

// global working memory
var wm: Fact[100];
var wm_count: int32 = 0;


// global rule base
var rules: Rule[50];
var rule_count: int32 = 0;


export fn add_rule(rule: Rule) -> void {
    rules[rule_count] = rule;
    rule_count += 1;
}

// does fact already exist
export fn fact_exists(f: Fact*) -> int32 {
   var i: int32 = 0;

   while (i < wm_count) {
       if (wm[i].predicate == f->predicate && wm[i].arity == f->arity) {
           var j: int32 = 0;
           var a_match: int32 = 1;

           while (j < f->arity) {
               if (wm[i].args[j] != f->args[j]) {
                   a_match = 0;
                   break;
               }
               j += 1;
           }
           if (a_match) {
               return 1;
           }
       }
       i += 1;
   }
   return 0;
}



// returns 1 if found and sets *value otherwise returns 0
fn lookup_binding(b: Binding*, var_name: string, value: string*) -> int32 {
   var i: int32 = 0;
   while (i < b->count) {
       if (b->vars[i] == var_name) {
           *value = b->values[i];
           return 1;
       }
       i += 1;
   }
   return 0;
}

// adds a binding, returning 1 on success (new binding or consistent with old one)
// 0 if var is already bound to a different val
fn add_binding(b: Binding*, var_name: string, val: string) -> int32 {
   var existing: string;

   if (lookup_binding(b, var_name, &existing)) {
      return existing == val;
   }

   if (b->count >= 4) {
      return 0;
   }

   b->vars[b->count] = var_name;
   b->values[b->count] = val;
   b->count = b->count + 1;

   return 1;
}

// match pattern against a fact, 1 on success and extends binding
fn unify_pattern(pat: AtomPattern*, fact: Fact*, binding: Binding*) -> int32 {
   // predicate names must match exactly
   if (pat->predicate != fact->predicate) {
      return 0;
   }

   if (pat->arity != fact->arity) {
       return 0;
    }

    var i: int32 = 0;

    while (i < pat->arity) {
        var term: Term = pat->args[i];

        if (term.kind == 0) {
            // Atom must equal fact arg
            if (term.name != fact->args[i]) {
                return 0;
            }
        } else {
            // bind var or check it
            if (!add_binding(binding, term.name, fact->args[i])) {
               return 0;
            }
        }
        i += 1;
    }
    return 1;
}

// find all ways a rule can be satisfied
fn match_rule(rule: Rule*, cond_idx: int32, current: Binding*, solutions: Binding*, sol_count: int32*) -> void {
   if (cond_idx == rule->cond_count) {
      if (*sol_count < 100) {
         var d: int32 = 0;
         while (d < current->count) {
             solutions[*sol_count].vars[d] = current->vars[d];
             solutions[*sol_count].values[d] = current->values[d];
             d += 1;
         }
         solutions[*sol_count].count = current->count;
         *sol_count = *sol_count + 1;
      }
      return;
   }

   // handle inequality
   if (rule->conditions[cond_idx].predicate == "neq" ||
       rule->conditions[cond_idx].predicate == "!=") {
      if (rule->conditions[cond_idx].arity != 2) {
         return;
      }
      var t1: Term = rule->conditions[cond_idx].args[0];
      var t2: Term = rule->conditions[cond_idx].args[1];
      var val1: string;
      var val2: string;

      if (t1.kind == 0) {
         val1 = t1.name;
      } else if (t1.kind == 1) {
         if (!lookup_binding(current, t1.name, &val1)) {
            return;
         }
      } else {
         return;
      }

      if (t2.kind == 0) {
         val2 = t2.name;
      } else if (t2.kind == 1) {
         if (!lookup_binding(current, t2.name, &val2)) {
            return;
         }
      } else {
         return;
      }

      if (val1 != val2) {
         match_rule(rule, cond_idx + 1, current, solutions, sol_count);
      }
      return;
   }

   // predicate not
   if (rule->conditions[cond_idx].predicate == "not") {
      if (rule->conditions[cond_idx].arity < 1) {
         return;
      }
      var inner_pred: string = rule->conditions[cond_idx].args[0].name;
      var inner_arity: int32 = rule->conditions[cond_idx].arity - 1;
      var inner_pattern: AtomPattern;
      inner_pattern.predicate = inner_pred;
      inner_pattern.arity = inner_arity;
      var k: int32 = 0;
      while (k < inner_arity) {
         inner_pattern.args[k] = rule->conditions[cond_idx].args[k + 1];
         k += 1;
      }
      var b: int32 = 0;
      while (b < inner_arity) {
         if (inner_pattern.args[b].kind == 1) {
            var dummy: string;
            if (!lookup_binding(current, inner_pattern.args[b].name, &dummy)) {
               return;
            }
         }
         b += 1;
      }
      var j: int32 = 0;
      while (j < wm_count) {
         var binding_copy: Binding;
         var d2: int32 = 0;
         while (d2 < current->count) {
            binding_copy.vars[d2] = current->vars[d2];
            binding_copy.values[d2] = current->values[d2];
            d2 += 1;
         }
         binding_copy.count = current->count;
         if (unify_pattern(&inner_pattern, &wm[j], &binding_copy)) {
            return;
         }
         j += 1;
      }
      match_rule(rule, cond_idx + 1, current, solutions, sol_count);
      return;
   }

   // try unify the current condition with every fact
   var i: int32 = 0;
   while (i < wm_count) {
       // copy binding, each attempt needs its own copy
       var next_binding: Binding;
       var d: int32 = 0;
       while (d < current->count) {
           next_binding.vars[d] = current->vars[d];
           next_binding.values[d] = current->values[d];
           d += 1;
       }
       next_binding.count = current->count;

       if (unify_pattern(&(rule->conditions[cond_idx]), &wm[i], &next_binding)) {
           // matched, move on
           match_rule(rule, cond_idx + 1, &next_binding, solutions, sol_count);
       }
       i += 1;
   }
}

fn instantiate_action(action: AtomPattern*, binding: Binding*) -> Fact {
   var fact: Fact;
   fact.predicate = action->predicate;
   fact.arity = action->arity;

   var i: int32 = 0;
   while (i < action->arity) {
       var term: Term = action->args[i];

       if (term.kind == 0) {
          fact.args[i] = term.name;
       } else {
         var value: string;
         if (lookup_binding(binding, term.name, &value)) {
            fact.args[i] = value;
         } else {
             // unbound var should not happen if well-formed
             fact.args[i] = "";
         }
       }
       i += 1;
   }
   return fact;
}

var trace_inference: int32 = 0;

export fn set_trace_inference(val: int32) -> void {
   trace_inference = val;
}

// API SIDE

export fn run_forward_chaining() -> void {
   var added: int32 = 1;

   while (added) {
      added = 0;

      // for each rule
      var r: int32 = 0;
      while (r < rule_count) {
         // find all solutions for the rule
         var solutions: Binding[100];
         var sol_count: int32 = 0;
         var initial_binding: Binding;
         initial_binding.count = 0;

         match_rule(&rules[r], 0, &initial_binding, &solutions[0], &sol_count);

         // init action, add if new for each solution
         var s: int32 = 0;

         while (s < sol_count) {
            var new_fact: Fact = instantiate_action(&rules[r].action, &solutions[s]);
            if (!fact_exists(&new_fact)) {
               add_fact(&new_fact);
               added = 1;

               if (trace_inference) {
                  print("Derived: ");
                  print(new_fact.predicate);
                  print("(");
                  var k: int32 = 0;
                  while (k < new_fact.arity) {
                     if (k > 0) {
                        print(", ");
                     }
                     print(new_fact.args[k]);
                     k += 1;
                  }
                  println(")");
               }
            }
            s += 1;
         }
         r += 1;
      }
   }
}

// display

export fn display_working_memory() -> void {
   println("");
   println("Final working memory:");
   var i: int32 = 0;
   while (i < wm_count) {
       print(wm[i].predicate);
       print("(");
       var j: int32 = 0;
       while (j < wm[i].arity) {
           if (j > 0) print(", ");
           print(wm[i].args[j]);
           j = j + 1;
       }
       println(")");
       i = i + 1;
   }
}

export fn print_fact(f: Fact*) -> void {
   print(f->predicate);
   print("(");
   var j: int32 = 0;
   while (j < f->arity) {
      if (j > 0) { print(", "); }
      print(f->args[j]);
      j += 1;
   }
   print(")");
}

export fn print_predicate_group(pred: string, label: string) -> void {
   println("");
   println(label);
   var i: int32 = 0;
   var found: int32 = 0;
   while (i < wm_count) {
      if (wm[i].predicate == pred) {
         print("  ");
         print_fact(&wm[i]);
         println("");
         found = 1;
      }
      i += 1;
   }
   if (!found) {
      println("  (none)");
   }
}

export fn display_relationships() -> void {
   println("");
   println("--- FAMILY RELATIONSHIPS ---");

   print_predicate_group("parent", "Parents");
   print_predicate_group("child", "Children");
