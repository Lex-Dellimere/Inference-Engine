   print_predicate_group("grandparent", "Grandparents");
   print_predicate_group("grandchild", "Grandchildren");
   print_predicate_group("grandmother", "Grandmothers");
   print_predicate_group("grandfather", "Grandfathers");
   print_predicate_group("granddaughter", "Granddaughters");
   print_predicate_group("grandson", "Grandsons");

   print_predicate_group("aunt", "Aunts");
   print_predicate_group("uncle", "Uncles");
   print_predicate_group("niece", "Nieces");
   print_predicate_group("nephew", "Nephews");

   print_predicate_group("cousin", "Cousins");

   print_predicate_group("ancestor", "Ancestors");
   print_predicate_group("descendant", "Descendants");

   print_predicate_group("parent_in_law", "Parents-in-law");
   print_predicate_group("mother_in_law", "Mothers-in-law");
   print_predicate_group("father_in_law", "Fathers-in-law");
   print_predicate_group("child_in_law", "Children-in-law");
   print_predicate_group("daughter_in_law", "Daughters-in-law");
